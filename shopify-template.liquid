{% layout none %}
{% comment %}
  X11 Creatine Gummies — High-Conversion Product Landing Page
  ============================================================
  SETUP:
  1. Copy this file to your Shopify theme → templates/product.creatine-landing.liquid
     (or templates/product.creatine-landing.json if using Online Store 2.0 — see SHOPIFY_SETUP.md)
  2. In Shopify Admin → Products → X11 Creatine Gummies → set "Theme template" to "creatine-landing"
  3. Replace placeholder images below with real CDN URLs from your Shopify files
{% endcomment %}

{% assign product_price    = product.selected_or_first_available_variant.price %}
{% assign compare_price    = product.selected_or_first_available_variant.compare_at_price %}
{% assign savings_pct      = compare_price | minus: product_price | times: 100 | divided_by: compare_price %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ product.description | strip_html | truncate: 155 }}">
  <title>{{ product.title }} | {{ shop.name }}</title>

  {{ content_for_header }}

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0A0A0F;
      --bg-card: #12121A;
      --bg-alt: #0F0F1A;
      --border: rgba(255,255,255,0.07);
      --pink: #FF3D8B;
      --coral: #FF6B35;
      --purple: #7B2FBE;
      --purple-light: #A855F7;
      --white: #FFFFFF;
      --gray: #A0A0B0;
      --gray-dark: #6B6B7B;
      --gold: #FFD700;
      --green: #22C55E;
      --red: #EF4444;
      --gradient: linear-gradient(135deg, #FF3D8B 0%, #FF6B35 100%);
      --radius: 16px;
      --pill: 50px;
      --max: 1100px;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 20px; }
    .sec { padding: 80px 0; }
    .sec-alt { background: var(--bg-alt); }
    @media (max-width: 768px) { .sec { padding: 56px 0; } }

    .tag {
      display: inline-block; padding: 5px 14px;
      background: rgba(255,61,139,0.1); border: 1px solid rgba(255,61,139,0.25);
      border-radius: var(--pill); color: var(--pink);
      font-size: 11px; font-weight: 700; letter-spacing: 1.8px;
      text-transform: uppercase; margin-bottom: 14px;
    }
    .h2 { font-size: clamp(28px,5vw,44px); font-weight: 900; line-height: 1.1; letter-spacing: -.5px; }
    .sub { font-size: 17px; color: var(--gray); max-width: 540px; margin: 12px auto 0; }
    .grad { background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stars { color: var(--gold); font-size: 15px; letter-spacing: 2px; }

    /* BUTTON — used for all non-form CTAs */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--gradient); color: #fff;
      font-size: 17px; font-weight: 800; padding: 18px 36px;
      border-radius: var(--pill); border: none; cursor: pointer;
      text-decoration: none; width: 100%; letter-spacing: .2px;
      box-shadow: 0 8px 32px rgba(255,61,139,.35);
      animation: glow 2.5s ease-in-out infinite; transition: transform .2s;
    }
    .btn:hover { transform: translateY(-2px); }
    @keyframes glow {
      0%,100% { box-shadow: 0 8px 32px rgba(255,61,139,.35); }
      50%      { box-shadow: 0 8px 48px rgba(255,61,139,.65); }
    }

    /* NAV */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(10,10,15,.92); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border); transition: transform .3s;
    }
    .nav.up { transform: translateY(-100%); }
    .nav-inner {
      max-width: var(--max); margin: 0 auto; padding: 12px 20px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo { font-size: 20px; font-weight: 900; letter-spacing: -.5px; }
    .logo span { color: var(--pink); }
    .nav-btn {
      background: var(--gradient); color: #fff; font-size: 13px; font-weight: 800;
      padding: 10px 22px; border-radius: var(--pill);
      border: none; cursor: pointer; text-decoration: none;
    }

    /* HERO */
    .hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
    .hero::before {
      content:''; position: absolute; top: -200px; right: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(123,47,190,.18) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero::after {
      content:''; position: absolute; bottom: -100px; left: -100px;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(255,61,139,.1) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; position: relative; z-index: 1; }
    @media (max-width: 768px) {
      .hero { padding: 90px 0 56px; }
      .hero-grid { grid-template-columns: 1fr; gap: 40px; }
      .hero-visual { order: -1; }
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,61,139,.08); border: 1px solid rgba(255,61,139,.22);
      border-radius: var(--pill); padding: 7px 14px; font-size: 13px; font-weight: 600;
      color: var(--pink); margin-bottom: 18px;
    }
    .hero h1 { font-size: clamp(34px,5.5vw,54px); font-weight: 900; line-height: 1.08; letter-spacing: -1px; margin-bottom: 18px; }
    .hero-sub { font-size: clamp(15px,2.2vw,18px); color: var(--gray); margin-bottom: 26px; line-height: 1.65; }
    .price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }
    .price-now { font-size: 36px; font-weight: 900; }
    .price-was { font-size: 20px; color: var(--gray-dark); text-decoration: line-through; }
    .price-save {
      background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.28);
      color: var(--green); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: var(--pill);
    }
    .cta-wrap { margin-bottom: 18px; }
    .proof-row { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--gray); flex-wrap: wrap; }
    .proof-dot { color: var(--border); }

    /* SHOPIFY ADD-TO-CART FORM */
    .atc-form .atc-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--gradient); color: #fff;
      font-size: 17px; font-weight: 800; padding: 18px 36px;
      border-radius: var(--pill); border: none; cursor: pointer;
      width: 100%; letter-spacing: .2px;
      box-shadow: 0 8px 32px rgba(255,61,139,.35);
      animation: glow 2.5s ease-in-out infinite; transition: transform .2s;
    }
    .atc-form .atc-btn:hover { transform: translateY(-2px); }
    .atc-form .atc-btn[disabled] { opacity: .5; cursor: not-allowed; animation: none; }

    /* PRODUCT IMAGE */
    .hero-visual { display: flex; justify-content: center; }
    .product-frame {
      width: 100%; max-width: 400px;
      background: linear-gradient(135deg, #1A0A2E, #12121A, #1A0A2E);
      border: 1px solid rgba(123,47,190,.28);
      border-radius: 24px; padding: 40px; text-align: center;
      position: relative; overflow: hidden;
    }
    .product-frame::before {
      content:''; position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 30%, rgba(255,61,139,.12) 0%, transparent 60%);
      pointer-events: none;
    }
    .product-frame img { width: 100%; max-width: 280px; height: auto; border-radius: 12px; position: relative; }
    .float-badge {
      position: absolute; background: var(--gradient); color: #fff;
      font-size: 11px; font-weight: 800; padding: 7px 14px; border-radius: var(--pill);
      box-shadow: 0 4px 20px rgba(255,61,139,.4);
    }
    .fb-tl { top: 18px; left: -8px; }
    .fb-br { bottom: 24px; right: -8px; }

    /* TRUST BAR */
    .trust-bar { background: var(--bg-card); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 18px 0; }
    .trust-pills { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .tp { display: flex; align-items: center; gap: 7px; padding: 9px 18px; background: rgba(255,255,255,.03); border: 1px solid var(--border); border-radius: var(--pill); font-size: 13px; font-weight: 600; }
    .tp-icon { width: 20px; height: 20px; background: var(--gradient); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; }

    /* PROBLEM */
    .prob-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 44px; }
    @media (max-width: 768px) { .prob-grid { grid-template-columns: 1fr; } }
    .prob-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 30px 24px; transition: border-color .3s, transform .3s; }
    .prob-card:hover { border-color: rgba(255,61,139,.28); transform: translateY(-4px); }
    .prob-icon { font-size: 38px; margin-bottom: 14px; display: block; }
    .prob-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; line-height: 1.3; }
    .prob-card p { color: var(--gray); font-size: 14px; }

    /* SOLUTION */
    .sol-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
    @media (max-width: 768px) { .sol-grid { grid-template-columns: 1fr; gap: 36px; } }
    .sol-features { display: flex; flex-direction: column; gap: 18px; margin-top: 28px; }
    .sol-feature { display: flex; gap: 14px; align-items: flex-start; }
    .sf-icon { width: 44px; height: 44px; flex-shrink: 0; background: rgba(255,61,139,.08); border: 1px solid rgba(255,61,139,.18); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .sf-text h4 { font-size: 15px; font-weight: 700; margin-bottom: 3px; }
    .sf-text p { font-size: 14px; color: var(--gray); }
    .sol-visual { background: var(--bg-card); border: 1px solid var(--border); border-radius: 24px; padding: 48px 28px; text-align: center; }
    .sol-visual-emoji { font-size: 72px; display: block; margin-bottom: 14px; }
    .sol-visual h3 { font-size: 22px; font-weight: 800; margin-bottom: 10px; line-height: 1.25; }
    .sol-visual p { color: var(--gray); font-size: 14px; font-style: italic; }

    /* STEPS */
    .steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 44px; }
    @media (max-width: 768px) { .steps { grid-template-columns: 1fr; } }
    .step { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 30px 22px; text-align: center; }
    .step-num { width: 42px; height: 42px; margin: 0 auto 14px; background: var(--gradient); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 900; box-shadow: 0 4px 20px rgba(255,61,139,.35); }
    .step-emoji { font-size: 44px; margin-bottom: 12px; display: block; }
    .step h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
    .step p { color: var(--gray); font-size: 14px; }

    /* SCIENCE */
    .sci-inner { background: var(--bg-card); border: 1px solid var(--border); border-radius: 24px; padding: 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    @media (max-width: 768px) { .sci-inner { grid-template-columns: 1fr; padding: 36px 22px; gap: 36px; } }
    .sci-text h2 { font-size: clamp(22px,4vw,34px); font-weight: 800; margin-bottom: 14px; line-height: 1.2; }
    .sci-text p { color: var(--gray); font-size: 15px; margin-bottom: 14px; }
    .sci-callout { background: rgba(123,47,190,.08); border: 1px solid rgba(123,47,190,.25); border-radius: 12px; padding: 14px 18px; font-size: 14px; color: var(--purple-light); font-weight: 600; }
    .sci-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .stat { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px 18px; text-align: center; }
    .stat-n { font-size: 30px; font-weight: 900; margin-bottom: 5px; }
    .stat-l { font-size: 12px; color: var(--gray); line-height: 1.4; }

    /* BENEFITS */
    .ben-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; margin-top: 44px; }
    @media (max-width: 600px) { .ben-grid { grid-template-columns: 1fr; } }
    .ben-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 24px; transition: border-color .3s, transform .3s; }
    .ben-card:hover { border-color: rgba(255,61,139,.28); transform: translateY(-4px); }
    .ben-icon { font-size: 34px; margin-bottom: 14px; display: block; }
    .ben-card h3 { font-size: 19px; font-weight: 800; margin-bottom: 8px; }
    .ben-card p { color: var(--gray); font-size: 14px; }

    /* REVIEWS */
    .rev-agg { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 44px; flex-wrap: wrap; }
    .rev-big { font-size: 60px; font-weight: 900; line-height: 1; }
    .rev-right .stars { font-size: 20px; }
    .rev-right p { color: var(--gray); font-size: 13px; margin-top: 3px; }
    .rev-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; }
    @media (max-width: 768px) { .rev-grid { grid-template-columns: 1fr; } }
    .rev-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; transition: border-color .3s; }
    .rev-card:hover { border-color: rgba(255,215,0,.25); }
    .rev-head { display: flex; align-items: center; gap: 11px; margin-bottom: 12px; }
    .rev-avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--gradient); display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 900; color: #fff; flex-shrink: 0; }
    .rev-name { font-size: 14px; font-weight: 700; }
    .rev-loc { font-size: 12px; color: var(--gray); }
    .rev-text { color: var(--gray); font-size: 14px; line-height: 1.65; }
    .rev-text strong { color: var(--white); }
    .verified { display: inline-flex; align-items: center; gap: 4px; color: var(--green); font-size: 12px; font-weight: 600; margin-top: 10px; }

    /* COMPARISON */
    .tbl-wrap { margin-top: 44px; overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius); border: 1px solid var(--border); }
    table { width: 100%; border-collapse: collapse; min-width: 520px; }
    th, td { padding: 15px 18px; text-align: center; font-size: 14px; border-bottom: 1px solid var(--border); }
    th { background: var(--bg-card); font-weight: 800; font-size: 13px; letter-spacing: .4px; padding: 18px; }
    th:first-child, td:first-child { text-align: left; color: var(--gray); font-weight: 600; }
    tr:last-child td { border-bottom: none; }
    tr:nth-child(even) { background: rgba(255,255,255,.015); }
    .th-hi { background: rgba(255,61,139,.08) !important; color: var(--pink) !important; border-left: 1px solid rgba(255,61,139,.2); border-right: 1px solid rgba(255,61,139,.2); }
    .td-hi { background: rgba(255,61,139,.04); border-left: 1px solid rgba(255,61,139,.14); border-right: 1px solid rgba(255,61,139,.14); }
    .win { color: var(--green); font-weight: 700; }
    .meh { color: #FFC107; }
    .los { color: var(--red); }

    /* FAQ */
    .faq-list { max-width: 700px; margin: 44px auto 0; }
    .faq-item { border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; overflow: hidden; transition: border-color .3s; }
    .faq-item.open { border-color: rgba(255,61,139,.28); }
    .faq-q { width: 100%; background: var(--bg-card); border: none; color: var(--white); font-size: 15px; font-weight: 600; padding: 20px 22px; text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 14px; transition: background .2s; }
    .faq-q:hover { background: rgba(255,61,139,.04); }
    .faq-plus { width: 26px; height: 26px; flex-shrink: 0; background: rgba(255,61,139,.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--pink); font-size: 17px; transition: transform .3s; }
    .faq-item.open .faq-plus { transform: rotate(45deg); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
    .faq-a-inner { padding: 0 22px 22px; background: var(--bg-card); color: var(--gray); font-size: 14px; line-height: 1.75; }

    /* GUARANTEE */
    .guar-inner { display: flex; align-items: center; gap: 44px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 24px; padding: 56px; max-width: 780px; margin: 0 auto; }
    @media (max-width: 768px) { .guar-inner { flex-direction: column; text-align: center; padding: 36px 22px; gap: 28px; } }
    .guar-badge { width: 128px; height: 128px; flex-shrink: 0; background: var(--gradient); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 40px rgba(255,61,139,.35); }
    .gbd { font-size: 38px; font-weight: 900; line-height: 1; }
    .gbl { font-size: 9px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; opacity: .88; }
    .guar-text h2 { font-size: clamp(20px,4vw,28px); font-weight: 800; margin-bottom: 10px; line-height: 1.3; }
    .guar-text p { color: var(--gray); font-size: 15px; line-height: 1.7; }

    /* FINAL CTA */
    .final-sec { background: linear-gradient(180deg, var(--bg) 0%, rgba(123,47,190,.09) 50%, var(--bg) 100%); text-align: center; }
    .urgency { display: inline-flex; align-items: center; gap: 7px; background: rgba(239,68,68,.08); border: 1px solid rgba(239,68,68,.25); border-radius: var(--pill); padding: 9px 18px; font-size: 13px; font-weight: 700; color: var(--red); margin-bottom: 28px; }
    .final-box { max-width: 500px; margin: 0 auto; }
    .final-box h2 { font-size: clamp(26px,5vw,42px); font-weight: 900; line-height: 1.1; margin-bottom: 14px; letter-spacing: -.5px; }
    .final-sub { color: var(--gray); font-size: 16px; margin-bottom: 28px; }
    .final-price { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }
    .micro { font-size: 13px; color: var(--gray); margin-top: 14px; }

    /* FOOTER */
    .footer { background: var(--bg-card); border-top: 1px solid var(--border); padding: 30px 0; text-align: center; }
    .footer-links { display: flex; justify-content: center; gap: 22px; margin-bottom: 14px; flex-wrap: wrap; }
    .footer-links a { color: var(--gray); text-decoration: none; font-size: 13px; }
    .footer-links a:hover { color: var(--white); }
    .footer-copy { color: var(--gray-dark); font-size: 12px; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    /* MOBILE STICKY */
    .mob-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 99; background: rgba(10,10,15,.96); backdrop-filter: blur(20px); border-top: 1px solid var(--border); padding: 11px 18px; display: none; align-items: center; gap: 12px; transform: translateY(100%); transition: transform .3s ease; }
    @media (max-width: 768px) { .mob-bar { display: flex; } }
    .mob-bar.on { transform: translateY(0); }
    .mob-prices .mp-now { font-size: 20px; font-weight: 900; }
    .mob-prices .mp-was { font-size: 12px; color: var(--gray); text-decoration: line-through; }
    .mob-atc-form { flex: 1; }
    .mob-atc-btn { width: 100%; background: var(--gradient); color: #fff; border: none; border-radius: var(--pill); padding: 13px 18px; font-size: 14px; font-weight: 800; cursor: pointer; animation: glow 2.5s ease-in-out infinite; }

    /* ANIMATIONS */
    .fi { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
    .fi.on { opacity: 1; transform: translateY(0); }
    .fi.d1 { transition-delay: .1s; }
    .fi.d2 { transition-delay: .2s; }
    .fi.d3 { transition-delay: .3s; }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <div class="logo">{{ shop.name | split: ' ' | first }}<span>{{ shop.name | split: ' ' | last }}</span></div>
    <a href="#cta" class="nav-btn">Add to Cart</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">🔥 #1 Creatine Gummy for Women</div>
        <h1>Get Stronger.<br>Recover Faster.<br><span class="grad">In 2 Strawberry Gummies.</span></h1>
        <p class="hero-sub">The only 5,000mg vegan creatine gummy that actually tastes good — and actually works. No mixing. No measuring. No chalky aftertaste.</p>

        <div class="price-row">
          {% if compare_price > product_price %}
            <span class="price-now grad">{{ product_price | money }}</span>
            <span class="price-was">{{ compare_price | money }}</span>
            <span class="price-save">Save {{ savings_pct }}%</span>
          {% else %}
            <span class="price-now grad">{{ product_price | money }}</span>
          {% endif %}
        </div>

        <div class="cta-wrap">
          {% form 'product', product, class: 'atc-form', id: 'hero-atc' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" name="add" class="atc-btn" id="heroCta"
              {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              🛒
              {% if product.selected_or_first_available_variant.available %}
                Add to Cart — Free Shipping Over $50
              {% else %}
                Sold Out
              {% endif %}
            </button>
          {% endform %}
        </div>

        <div class="proof-row">
          <span class="stars">★★★★★</span>
          <strong>4.9/5</strong>
          <span class="proof-dot">·</span>
          <span>2,847 reviews</span>
