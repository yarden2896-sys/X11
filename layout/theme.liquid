<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {%- if page_title == blank -%}{{ shop.name }}{%- else -%}{{ page_title }} | {{ shop.name }}{%- endif -%}
  </title>
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0A0A0F; color: #fff; line-height: 1.6; }
    a { color: #FF3D8B; }
    .site-nav { background: rgba(10,10,15,0.95); border-bottom: 1px solid rgba(255,255,255,0.07); padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; }
    .site-nav a { text-decoration: none; color: #fff; font-weight: 700; font-size: 18px; }
    .site-nav a span { color: #FF3D8B; }
    .nav-links { display: flex; gap: 20px; }
    .nav-links a { font-size: 14px; font-weight: 500; }
    .main-content { min-height: 60vh; }
    .site-footer { background: #12121A; border-top: 1px solid rgba(255,255,255,0.07); padding: 30px 20px; text-align: center; color: #6B6B7B; font-size: 13px; }
  </style>
</head>
<body>
  <header class="site-nav">
    <a href="/">X<span>11</span> Supplements</a>
    <nav class="nav-links">
      <a href="/collections/all">Shop</a>
      <a href="/cart">Cart ({{ cart.item_count }})</a>
    </nav>
  </header>

  <main class="main-content">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </footer>
</body>
</html>
