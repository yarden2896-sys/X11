<div style="max-width:700px;margin:0 auto;padding:40px 20px">
  <h1 style="font-size:28px;font-weight:900;margin-bottom:28px">Your Cart</h1>
  {% if cart.item_count == 0 %}
    <p style="color:#A0A0B0;margin-bottom:24px">Your cart is empty.</p>
    <a href="/collections/all" style="background:linear-gradient(135deg,#FF3D8B,#FF6B35);color:#fff;padding:14px 28px;border-radius:50px;text-decoration:none;font-weight:800">Continue Shopping</a>
  {% else %}
    {% for item in cart.items %}
      <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,0.07)">
        {% if item.image %}{{ item.image | image_url: width: 80 | image_tag: style: 'width:80px;height:80px;object-fit:cover;border-radius:8px' }}{% endif %}
        <div style="flex:1">
          <div style="font-weight:700">{{ item.product.title }}</div>
          <div style="color:#A0A0B0;font-size:14px">Qty: {{ item.quantity }}</div>
          <div style="color:#FF3D8B;font-weight:700">{{ item.line_price | money }}</div>
        </div>
      </div>
    {% endfor %}
    <div style="text-align:right;padding-top:20px">
      <div style="font-size:20px;font-weight:900;margin-bottom:16px">Total: {{ cart.total_price | money }}</div>
      <a href="/checkout" style="background:linear-gradient(135deg,#FF3D8B,#FF6B35);color:#fff;padding:16px 36px;border-radius:50px;text-decoration:none;font-weight:800;font-size:16px">Checkout</a>
    </div>
  {% endif %}
</div>
