<div style="max-width:1100px;margin:0 auto;padding:40px 20px">
  <h1 style="font-size:32px;font-weight:900;margin-bottom:32px">{{ collection.title }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px">
    {% for product in collection.products %}
      <a href="{{ product.url }}" style="text-decoration:none;background:#12121A;border:1px solid rgba(255,255,255,0.07);border-radius:16px;overflow:hidden;display:block">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 400 | image_tag: style: 'width:100%;aspect-ratio:1;object-fit:cover' }}
        {% endif %}
        <div style="padding:16px">
          <div style="font-weight:700;margin-bottom:6px;color:#fff">{{ product.title }}</div>
          <div style="color:#FF3D8B;font-weight:800">{{ product.price | money }}</div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
