{% layout none %}
{% assign v = product.selected_or_first_available_variant %}
{% assign base_price = v.price %}
{% assign compare = v.compare_at_price %}
{% assign pct = compare | minus: base_price | times: 100 | divided_by: compare %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="X11 Vegan Creatine Monohydrate Gummies — 5,000mg in 2 strawberry gummies. The creatine women actually stick to. 30-day money-back guarantee.">
  <title>X11 Creatine Gummies – Finally a Creatine You'll Actually Take Every Day</title>
  {{ content_for_header }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#080810;--card:#0F0F1C;--card2:#13131F;
      --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.1);
      --pink:#FF2D78;--coral:#FF6B35;--purple:#7B2FBE;--plum:#4B1D8F;
      --white:#FFFFFF;--off:#E8E8F0;--gray:#9090A8;--muted:#5A5A72;
      --gold:#FFD700;--green:#22C55E;--red:#F43F5E;
      --grad:linear-gradient(135deg,#FF2D78 0%,#FF6B35 100%);
      --grad2:linear-gradient(135deg,#7B2FBE 0%,#FF2D78 100%);
      --r:16px;--pill:50px;--max:1080px;
    }
    html{scroll-behavior:smooth}
    body{background:var(--bg);color:var(--white);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    img{max-width:100%;display:block}
    .wrap{max-width:var(--max);margin:0 auto;padding:0 20px}
    .wrap-sm{max-width:740px;margin:0 auto;padding:0 20px}
    .wrap-xs{max-width:560px;margin:0 auto;padding:0 20px}
    .sec{padding:88px 0}
    .sec-alt{background:var(--card2)}
    .tc{text-align:center}
    @media(max-width:768px){.sec{padding:60px 0}}

    .tag{display:inline-block;padding:5px 14px;background:rgba(255,45,120,0.1);border:1px solid rgba(255,45,120,0.25);border-radius:var(--pill);color:var(--pink);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px}
    .tag-green{background:rgba(34,197,94,0.1);border-color:rgba(34,197,94,0.25);color:var(--green)}
    .tag-purple{background:rgba(123,47,190,0.1);border-color:rgba(123,47,190,0.25);color:#A855F7}
    .h1{font-size:clamp(36px,6vw,62px);font-weight:900;line-height:1.06;letter-spacing:-1.5px}
    .h2{font-size:clamp(26px,4.5vw,44px);font-weight:900;line-height:1.1;letter-spacing:-0.5px}
    .lead{font-size:clamp(16px,2.2vw,19px);color:var(--gray);line-height:1.7}
    .body-copy{font-size:16px;color:var(--gray);line-height:1.75}
    .grad-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .grad2-text{background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .stars{color:var(--gold);letter-spacing:2px}

    /* BUTTONS */
    @keyframes pulse{0%,100%{box-shadow:0 10px 40px rgba(255,45,120,0.38)}50%{box-shadow:0 10px 56px rgba(255,45,120,0.65)}}
    .atc-form .atc-btn{display:flex;align-items:center;justify-content:center;gap:9px;background:var(--grad);color:#fff;font-size:17px;font-weight:800;padding:19px 36px;border-radius:var(--pill);border:none;cursor:pointer;width:100%;letter-spacing:.2px;box-shadow:0 10px 40px rgba(255,45,120,0.38);animation:pulse 2.8s ease-in-out infinite;transition:transform .2s}
    .atc-form .atc-btn:hover{transform:translateY(-2px)}
    .atc-form .atc-btn[disabled]{opacity:.45;cursor:not-allowed;animation:none}
    .atc-form .atc-btn.outline{background:transparent;border:2px solid rgba(255,45,120,0.4);color:var(--pink);box-shadow:none;animation:none}

    /* ANNOUNCE */
    .ann{background:var(--grad);padding:10px 20px;text-align:center;font-size:13px;font-weight:700;letter-spacing:.4px;position:relative;z-index:200}

    /* NAV */
    .nav{position:fixed;top:0;left:0;right:0;z-index:150;background:rgba(8,8,16,0.94);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);transition:transform .3s}
    .nav.hide{transform:translateY(-100%)}
    .nav-in{max-width:var(--max);margin:0 auto;padding:11px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .logo{font-size:19px;font-weight:900;text-decoration:none;color:#fff;letter-spacing:-.5px}
    .logo span{color:var(--pink)}
    .nav-social{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--gray)}
    @media(max-width:480px){.nav-social{display:none}}
    .nav-cta{background:var(--grad);color:#fff;font-size:13px;font-weight:800;padding:10px 20px;border-radius:var(--pill);border:none;cursor:pointer;text-decoration:none;white-space:nowrap}

    /* HERO */
    .hero{padding:108px 0 72px;position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;top:-300px;right:-200px;width:700px;height:700px;background:radial-gradient(circle,rgba(123,47,190,.22) 0%,transparent 65%);pointer-events:none}
    .hero::after{content:'';position:absolute;bottom:-200px;left:-150px;width:500px;height:500px;background:radial-gradient(circle,rgba(255,45,120,.14) 0%,transparent 65%);pointer-events:none}
    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;position:relative;z-index:1}
    @media(max-width:768px){.hero{padding:80px 0 56px}.hero-grid{grid-template-columns:1fr;gap:44px}.hero-img{order:-1}}

    .eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap}
    .eyebrow-stars{display:flex;align-items:center;gap:6px;background:rgba(255,215,0,.08);border:1px solid rgba(255,215,0,.2);border-radius:var(--pill);padding:6px 12px;font-size:12px;font-weight:700;color:var(--gold)}
    .hero h1{margin-bottom:18px}
    .hero-sub{font-size:clamp(15px,2vw,18px);color:var(--gray);margin-bottom:28px;line-height:1.7;max-width:520px}

    .price-row{display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap}
    .p-now{font-size:38px;font-weight:900}
    .p-was{font-size:22px;color:var(--muted);text-decoration:line-through}
    .p-save{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:var(--green);font-size:13px;font-weight:700;padding:5px 13px;border-radius:var(--pill)}

    .timer-wrap{display:flex;align-items:center;gap:10px;margin-bottom:22px;flex-wrap:wrap}
    .t-label{font-size:12px;font-weight:700;color:var(--red);text-transform:uppercase;letter-spacing:1px}
    .timer{display:flex;gap:6px}
    .tseg{background:var(--card);border:1px solid var(--border2);border-radius:8px;padding:6px 10px;text-align:center;min-width:44px}
    .tnum{font-size:20px;font-weight:900;line-height:1;display:block}
    .tlbl{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;display:block;margin-top:2px}
    .tsep{font-size:18px;font-weight:900;color:var(--red);align-self:center;margin-top:-4px}

    .cta-wrap{margin-bottom:16px}
    .proof-row{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--gray);flex-wrap:wrap}
    .pdot{color:var(--border2)}

    /* PRODUCT FRAME */
    .hero-img{display:flex;justify-content:center}
    .pframe{width:100%;max-width:420px;background:linear-gradient(145deg,#180A2E,#0F0F1C,#180A2E);border:1px solid rgba(123,47,190,.3);border-radius:28px;padding:44px 36px;text-align:center;position:relative;overflow:hidden}
    @media(max-width:768px){.pframe{max-width:100%;padding:32px 20px;border-radius:20px}}
    .pframe::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 20%,rgba(255,45,120,.14) 0%,transparent 55%);pointer-events:none}
    .pbottle{width:190px;height:270px;margin:0 auto 20px;background:var(--grad);border-radius:95px 95px 50px 50px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 24px 70px rgba(255,45,120,.45),0 0 0 1px rgba(255,255,255,.08);position:relative}
    @media(max-width:768px){.pbottle{width:160px;height:230px}}
    .pbottle::after{content:'';position:absolute;top:10px;left:20px;right:20px;height:40%;background:linear-gradient(180deg,rgba(255,255,255,.18) 0%,transparent 100%);border-radius:80px}
    .pb-em{font-size:60px;line-height:1;margin-bottom:4px;position:relative;z-index:1}
    .pb-name{font-size:9px;font-weight:800;letter-spacing:2.5px;color:rgba(255,255,255,.8);text-transform:uppercase;position:relative;z-index:1}
    .pb-dose{font-size:28px;font-weight:900;color:#fff;position:relative;z-index:1}
    .pb-sub{font-size:11px;font-weight:700;color:rgba(255,255,255,.7);position:relative;z-index:1}
    .pframe img{width:100%;max-width:320px;margin:0 auto 16px;border-radius:12px;position:relative}
    @media(max-width:768px){.pframe img{max-width:100%}}
    .ftag{position:absolute;background:var(--grad);color:#fff;font-size:11px;font-weight:800;padding:7px 14px;border-radius:var(--pill);box-shadow:0 4px 20px rgba(255,45,120,.4);white-space:nowrap}
    .ftl{top:22px;left:-8px}
    .fbr{bottom:28px;right:-8px}
    .pcaption{color:var(--gray);font-size:12px;position:relative;z-index:1}
    .mini-bs{display:flex;justify-content:center;gap:8px;margin-top:20px;flex-wrap:wrap}
    .mib{background:rgba(255,255,255,.04);border:1px solid var(--border2);border-radius:var(--pill);padding:6px 12px;font-size:11px;font-weight:600;color:var(--off);display:flex;align-items:center;gap:5px}

    /* TRUST BAR */
    .tbar{background:var(--card);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:18px 0}
    .tscroll{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
    .tp{display:flex;align-items:center;gap:7px;padding:9px 16px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:var(--pill);font-size:13px;font-weight:600;white-space:nowrap}
    .tpi{width:20px;height:20px;background:var(--grad);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0}

    /* PROOF BAND */
    .proof-band{background:var(--card2);padding:56px 0}
    .pnums{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    @media(max-width:640px){.pnums{grid-template-columns:repeat(2,1fr)}}
    .pn{text-align:center;padding:28px 16px}
    .pn-n{font-size:clamp(34px,5vw,52px);font-weight:900;line-height:1;margin-bottom:6px}
    .pn-l{font-size:13px;color:var(--gray)}

    /* STORY */
    .story-in{max-width:780px;margin:0 auto}
    .pull-quote{font-size:clamp(20px,3vw,32px);font-weight:800;line-height:1.3;margin-bottom:32px;border-left:4px solid var(--pink);padding-left:24px}
    .story-body{font-size:17px;color:var(--gray);line-height:1.85}
    .story-body p{margin-bottom:20px}
    .story-body strong{color:var(--white);font-weight:700}
    .story-body em{color:var(--pink);font-style:normal;font-weight:600}

    /* PAIN CARDS */
    .pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}
    @media(max-width:768px){.pain-grid{grid-template-columns:1fr}}
    .pain-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:28px 22px;border-top:3px solid rgba(244,63,94,.4)}
    .pi{font-size:36px;margin-bottom:14px;display:block}
    .pain-card h3{font-size:16px;font-weight:700;margin-bottom:8px;line-height:1.3}
    .pain-card p{color:var(--gray);font-size:14px}

    /* REVEAL */
    .rev-grid2{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    @media(max-width:768px){.rev-grid2{grid-template-columns:1fr;gap:40px}}
    .rfeatures{display:flex;flex-direction:column;gap:22px;margin-top:28px}
    .rf{display:flex;gap:14px;align-items:flex-start}
    .rfi{width:48px;height:48px;flex-shrink:0;background:rgba(255,45,120,.08);border:1px solid rgba(255,45,120,.18);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px}
    .rft h4{font-size:15px;font-weight:700;margin-bottom:3px}
    .rft p{font-size:14px;color:var(--gray)}
    .facts-box{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;padding:16px;position:relative}
    .facts-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px}
    .facts-row:last-child{border-bottom:none}

    /* INGREDIENTS */
    .ing-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:44px}
    @media(max-width:640px){.ing-grid{grid-template-columns:1fr}}
    .ing-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:24px;display:flex;gap:16px;align-items:flex-start}
    .idot{width:10px;height:10px;border-radius:50%;background:var(--grad);flex-shrink:0;margin-top:5px}
    .iname{font-size:15px;font-weight:700;margin-bottom:4px}
    .iamt{font-size:12px;font-weight:800;color:var(--pink);margin-bottom:6px}
    .idesc{font-size:13px;color:var(--gray)}
    .clean-label{margin-top:32px;background:rgba(34,197,94,.06);border:1px solid rgba(34,197,94,.2);border-radius:var(--r);padding:20px 24px;display:flex;align-items:center;gap:12px}

    /* STEPS */
    .steps-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
    @media(max-width:768px){.steps-row{grid-template-columns:1fr}}
    .scard{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:30px 22px;text-align:center}
    .snum{width:44px;height:44px;margin:0 auto 14px;background:var(--grad);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;box-shadow:0 4px 24px rgba(255,45,120,.38)}
    .sem{font-size:48px;margin-bottom:14px;display:block}
    .scard h3{font-size:17px;font-weight:700;margin-bottom:8px}
    .scard p{font-size:14px;color:var(--gray)}

    /* SCIENCE */
    .sci-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
    @media(max-width:768px){.sci-grid{grid-template-columns:1fr;gap:36px}}
    .sci-box{background:var(--card);border:1px solid var(--border);border-radius:24px;padding:56px;position:relative;overflow:hidden}
    .sci-box::before{content:'';position:absolute;top:-80px;right:-80px;width:260px;height:260px;background:radial-gradient(circle,rgba(123,47,190,.18) 0%,transparent 70%);pointer-events:none}
    .sci-text h2{font-size:clamp(22px,3.5vw,34px);font-weight:800;margin-bottom:14px;line-height:1.2}
    .sci-text p{color:var(--gray);font-size:15px;margin-bottom:14px;line-height:1.75}
    .sci-callout{background:rgba(123,47,190,.08);border:1px solid rgba(123,47,190,.22);border-radius:12px;padding:16px 20px;font-size:14px;color:#A855F7;font-weight:600;line-height:1.6}
    .sci-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .stat{background:var(--bg);border:1px solid var(--border);border-radius:var(--r);padding:22px 16px;text-align:center}
    .stat-n{font-size:30px;font-weight:900;margin-bottom:5px}
    .stat-l{font-size:12px;color:var(--gray);line-height:1.4}

    /* BENEFITS */
    .ben-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:44px}
    @media(max-width:600px){.ben-grid{grid-template-columns:1fr}}
    .bcard{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:30px 26px;transition:border-color .3s,transform .3s}
    .bcard:hover{border-color:rgba(255,45,120,.3);transform:translateY(-4px)}
    .bicon{font-size:36px;margin-bottom:14px;display:block}
    .bcard h3{font-size:20px;font-weight:800;margin-bottom:10px}
    .bcard p{color:var(--gray);font-size:14px;line-height:1.7}
    .bstat{display:inline-block;margin-top:12px;font-size:12px;font-weight:700;color:var(--pink);background:rgba(255,45,120,.08);border:1px solid rgba(255,45,120,.2);padding:4px 12px;border-radius:var(--pill)}

    /* REVIEWS */
    .ragg{display:flex;align-items:center;justify-content:center;gap:20px;margin:36px auto 44px;flex-wrap:wrap;background:var(--card);border:1px solid var(--border);border-radius:24px;padding:36px;max-width:500px}
    .rbig{font-size:72px;font-weight:900;line-height:1}
    .rright .stars{font-size:24px}
    .rright p{color:var(--gray);font-size:13px;margin-top:4px}
    .rev-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    @media(max-width:768px){.rev-grid{grid-template-columns:1fr}}
    .rcard{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:26px;transition:border-color .3s}
    .rcard:hover{border-color:rgba(255,215,0,.25)}
    .rcard.feat{border-color:rgba(255,45,120,.3);background:linear-gradient(145deg,rgba(255,45,120,.04),var(--card))}
    .rhead{display:flex;align-items:center;gap:11px;margin-bottom:12px}
    .rav{width:46px;height:46px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:900;color:#fff;flex-shrink:0}
    .rname{font-size:14px;font-weight:700}
    .rloc{font-size:12px;color:var(--gray)}
    .rtitle{font-size:15px;font-weight:700;margin-bottom:8px}
    .rtext{color:var(--gray);font-size:14px;line-height:1.65}
    .rtext strong{color:var(--white)}
    .verified{display:inline-flex;align-items:center;gap:4px;color:var(--green);font-size:12px;font-weight:600;margin-top:10px}
    .wbadge{display:inline-block;background:rgba(255,45,120,.08);border:1px solid rgba(255,45,120,.2);color:var(--pink);font-size:11px;font-weight:700;padding:3px 10px;border-radius:var(--pill);margin-top:8px}

    /* MINI REVIEWS */
    .rev-mini-list{display:flex;flex-direction:column;gap:14px;margin-top:18px}
    .rmini{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px 20px;display:flex;gap:14px;align-items:flex-start}
    .rmini-av{width:36px;height:36px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;color:#fff;flex-shrink:0}
    .rmini-name{font-size:13px;font-weight:700;margin-bottom:3px}
    .rmini-text{font-size:13px;color:var(--gray)}

    /* COMPARISON */
    .tbl-wrap{margin-top:44px;overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--r);border:1px solid var(--border)}
    table{width:100%;border-collapse:collapse;min-width:500px}
    th,td{padding:15px 18px;text-align:center;font-size:14px;border-bottom:1px solid var(--border)}
    th{background:var(--card);font-weight:800;font-size:13px;letter-spacing:.3px;padding:18px}
    th:first-child,td:first-child{text-align:left;color:var(--gray);font-weight:600;font-size:13px}
    tr:last-child td{border-bottom:none}
    tr:nth-child(even){background:rgba(255,255,255,.015)}
    .thi{background:rgba(255,45,120,.08)!important;color:var(--pink)!important;border-left:1px solid rgba(255,45,120,.2);border-right:1px solid rgba(255,45,120,.2)}
    .tdi{background:rgba(255,45,120,.04);border-left:1px solid rgba(255,45,120,.12);border-right:1px solid rgba(255,45,120,.12)}
    .win{color:var(--green);font-weight:700}
    .meh{color:#FFC107}
    .los{color:var(--red)}

    /* PRICING */
    .pricing-sec{background:linear-gradient(180deg,var(--bg) 0%,rgba(75,29,143,.12) 50%,var(--bg) 100%)}
    .pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
    @media(max-width:768px){.pgrid{grid-template-columns:1fr;max-width:400px;margin-left:auto;margin-right:auto}}
    .pcard{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:30px 24px;text-align:center;position:relative;transition:transform .3s,border-color .3s}
    .pcard:hover{transform:translateY(-4px)}
    .pcard.pop{border-color:var(--pink);background:linear-gradient(165deg,rgba(255,45,120,.06),var(--card))}
    .pop-badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--grad);color:#fff;font-size:11px;font-weight:800;padding:5px 16px;border-radius:var(--pill);white-space:nowrap;letter-spacing:.5px}
    .pc-qty{font-size:12px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px}
    .pc-supply{font-size:13px;color:var(--muted);margin-bottom:20px}
    .pc-price{font-size:42px;font-weight:900;line-height:1;margin-bottom:4px}
    .pc-per{font-size:13px;color:var(--gray);margin-bottom:6px}
