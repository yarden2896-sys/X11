<!-- MOBILE STICKY -->
<div class="mbar" id="mobBar">
  <div class="mprices">
    <div class="mpnow">{{ base_price | money }}</div>
    {% if compare > base_price %}<div class="mpwas">{{ compare | money }}</div>{% endif %}
  </div>
  {% form 'product', product, class: 'matc', id: 'mob-form' %}
    <input type="hidden" name="id" value="{{ v.id }}">
    <button type="submit" name="add" class="matc-btn" {% unless v.available %}disabled{% endunless %}>
      🛒 {% if v.available %}Add to Cart — Save {{ pct }}%{% else %}Sold Out{% endif %}
    </button>
  {% endform %}
</div>

{{ content_for_layout }}

<script>
  // COUNTDOWN TIMER
  (function(){
    const K='x11_end';
    let end=parseInt(localStorage.getItem(K)||'0');
    if(!end||end<Date.now()){end=Date.now()+23*3600000+47*60000+12000;localStorage.setItem(K,end);}
    function tick(){
      const d=Math.max(0,end-Date.now());
      const p=n=>String(n).padStart(2,'0');
      document.getElementById('th').textContent=p(Math.floor(d/3600000));
      document.getElementById('tm').textContent=p(Math.floor((d%3600000)/60000));
      document.getElementById('ts').textContent=p(Math.floor((d%60000)/1000));
      if(d>0)setTimeout(tick,1000);
    }
    tick();
  })();

  // FAQ
  document.querySelectorAll('.fq').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const item=btn.closest('.fi2'),ans=item.querySelector('.fa'),open=item.classList.contains('open');
      document.querySelectorAll('.fi2').forEach(i=>{i.classList.remove('open');i.querySelector('.fa').style.maxHeight='0';i.querySelector('.fq').setAttribute('aria-expanded','false');});
      if(!open){item.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';btn.setAttribute('aria-expanded','true');}
    });
  });

  // STICKY NAV
  let lastY=0;const nav=document.getElementById('nav');
  window.addEventListener('scroll',()=>{const y=window.scrollY;nav.classList.toggle('hide',y>lastY&&y>100);lastY=y;},{passive:true});

  // MOBILE BAR
  const mb=document.getElementById('mobBar'),hc=document.getElementById('heroCta');
  if(hc&&mb)new IntersectionObserver(e=>{mb.classList.toggle('on',!e[0].isIntersecting)},{threshold:0}).observe(hc);

  // FADE IN
  const io=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('on');io.unobserve(x.target);}});},{threshold:0.07,rootMargin:'0px 0px -28px 0px'});
  document.querySelectorAll('.fi').forEach(el=>io.observe(el));

  // AJAX CART
  function fmtMoney(c){return'$'+(c/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function openCart(){
    document.getElementById('cartOv').classList.add('on');
    document.getElementById('cartDrawer').classList.add('on');
    document.body.style.overflow='hidden';
    refreshCart();
  }
  function closeCart(){
    document.getElementById('cartOv').classList.remove('on');
    document.getElementById('cartDrawer').classList.remove('on');
    document.body.style.overflow='';
  }
  async function refreshCart(){
    try{
      const cart=await(await fetch('/cart.js')).json();
      const body=document.getElementById('cdBody');
      const foot=document.getElementById('cdFoot');
      const tot=document.getElementById('cdTotal');
      if(cart.item_count===0){
        body.innerHTML='<div class="cd-empty-msg"><div style="font-size:44px;margin-bottom:14px">🛒</div><p>Your cart is empty</p></div>';
        foot.style.display='none';
      }else{
        body.innerHTML='<div class="cd-success"><div style="font-size:32px">✅</div><p>Added to your cart!</p></div>'+
          cart.items.map(item=>`<div class="cd-item">${item.image?`<img src="${item.image}" class="cd-img" alt="${item.product_title}">`:'<div class="cd-img"></div>'}<div class="cd-info"><div class="cd-name">${item.product_title}</div><div class="cd-qty">Qty: ${item.quantity}</div><div class="cd-price">${fmtMoney(item.line_price)}</div></div></div>`).join('');
        tot.textContent=fmtMoney(cart.total_price);
        foot.style.display='flex';
      }
    }catch(e){console.error('Cart error',e);}
  }
  document.querySelectorAll('.atc-form,.matc').forEach(form=>{
    form.addEventListener('submit',async e=>{
      e.preventDefault();
      const btn=form.querySelector('button[name="add"]');
      if(!btn||btn.disabled)return;
      const orig=btn.innerHTML;
      btn.disabled=true;
      btn.innerHTML='Adding…';
      try{
        const res=await fetch('/cart/add.js',{method:'POST',body:new FormData(form)});
        if(res.ok){
          btn.innerHTML='✓ Added!';
          openCart();
          setTimeout(()=>{btn.disabled=false;btn.innerHTML=orig;},2500);
        }else{
          const err=await res.json().catch(()=>({}));
          btn.innerHTML=err.description||'Try again';
          btn.disabled=false;
        }
      }catch(err){btn.innerHTML='Try again';btn.disabled=false;}
    });
  });
</script>
</body>
</html>
