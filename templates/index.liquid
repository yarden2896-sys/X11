{% layout none %}
{% assign fp = collections.all.products.first %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="X11 Supplements — Vegan Creatine Gummies with 5,000mg per serving. The creatine women actually take every day. Real strawberry flavor. 30-day guarantee.">
  <title>X11 Supplements — Vegan Creatine Gummies That Actually Work</title>
  {{ content_for_header }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#080810;--card:#0F0F1C;--card2:#13131F;
      --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.1);
      --pink:#FF2D78;--coral:#FF6B35;--purple:#7B2FBE;
      --white:#FFFFFF;--gray:#9090A8;--muted:#5A5A72;
      --gold:#FFD700;--green:#22C55E;
      --grad:linear-gradient(135deg,#FF2D78 0%,#FF6B35 100%);
      --grad2:linear-gradient(135deg,#7B2FBE 0%,#FF2D78 100%);
      --r:16px;--pill:50px;--max:1080px;
    }
    html{scroll-behavior:smooth}
    body{background:var(--bg);color:var(--white);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    img{max-width:100%;display:block}
    .wrap{max-width:var(--max);margin:0 auto;padding:0 20px}
    .sec{padding:80px 0}
    .tc{text-align:center}
    @media(max-width:768px){.sec{padding:56px 0}}
    .grad-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .stars{color:var(--gold)}
    @keyframes pulse{0%,100%{box-shadow:0 10px 40px rgba(255,45,120,.38)}50%{box-shadow:0 10px 56px rgba(255,45,120,.65)}}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
    .fi{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .65s ease}
    .fi.on{opacity:1;transform:translateY(0)}
    .d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}

    /* ANNOUNCE */
    .ann{background:var(--grad);padding:10px 20px;text-align:center;font-size:13px;font-weight:700;letter-spacing:.3px}

    /* NAV */
    .nav{background:rgba(8,8,16,.94);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);padding:12px 20px}
    .nav-in{max-width:var(--max);margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .logo{font-size:20px;font-weight:900;text-decoration:none;color:#fff;letter-spacing:-.5px}
    .logo span{color:var(--pink)}
    .nav-links{display:flex;align-items:center;gap:22px}
    .nav-links a{color:var(--gray);text-decoration:none;font-size:14px;font-weight:500;transition:color .2s}
    .nav-links a:hover{color:var(--white)}
    @media(max-width:640px){.nav-links{display:none}}
    .nav-cta{background:var(--grad);color:#fff;font-size:13px;font-weight:800;padding:10px 22px;border-radius:var(--pill);text-decoration:none;white-space:nowrap}

    /* HERO */
    .hero{padding:96px 0 72px;position:relative;overflow:hidden;min-height:92vh;display:flex;align-items:center}
    .hero::before{content:'';position:absolute;top:-300px;right:-200px;width:700px;height:700px;background:radial-gradient(circle,rgba(123,47,190,.2) 0%,transparent 65%);pointer-events:none}
    .hero::after{content:'';position:absolute;bottom:-200px;left:-150px;width:500px;height:500px;background:radial-gradient(circle,rgba(255,45,120,.13) 0%,transparent 65%);pointer-events:none}
    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;width:100%;position:relative;z-index:1}
    @media(max-width:768px){.hero{min-height:auto;padding:80px 0 56px}.hero-grid{grid-template-columns:1fr;gap:44px}.hero-visual{order:-1}}
    .hero h1{font-size:clamp(36px,5.5vw,60px);font-weight:900;line-height:1.06;letter-spacing:-1.5px;margin-bottom:18px}
    .hero-sub{font-size:clamp(16px,2vw,18px);color:var(--gray);margin-bottom:28px;line-height:1.7;max-width:500px}
    .hero-price{display:flex;align-items:center;gap:12px;margin-bottom:28px;flex-wrap:wrap}
    .price-now{font-size:38px;font-weight:900;color:var(--white)}
    .price-was{font-size:20px;color:var(--muted);text-decoration:line-through}
    .price-save{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.25);color:var(--green);font-size:13px;font-weight:700;padding:5px 12px;border-radius:var(--pill)}
    .hero-cta{display:inline-block;background:var(--grad);color:#fff;font-size:17px;font-weight:800;padding:18px 40px;border-radius:var(--pill);text-decoration:none;box-shadow:0 10px 40px rgba(255,45,120,.38);animation:pulse 2.8s ease-in-out infinite;transition:transform .2s;margin-bottom:16px;text-align:center}
    .hero-cta:hover{transform:translateY(-2px)}
    .hero-proof{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--gray);flex-wrap:wrap}
    .hero-proof strong{color:var(--white)}

    /* PRODUCT VISUAL */
    .pvisual{width:100%;max-width:420px;margin:0 auto;background:linear-gradient(145deg,#180A2E,#0F0F1C,#180A2E);border:1px solid rgba(123,47,190,.3);border-radius:28px;padding:44px 36px;text-align:center;position:relative;overflow:hidden}
    @media(max-width:768px){.pvisual{max-width:100%;padding:32px 20px;border-radius:20px}}
    .pvisual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 20%,rgba(255,45,120,.14) 0%,transparent 55%);pointer-events:none}
    .pbottle{width:190px;height:270px;margin:0 auto 20px;background:var(--grad);border-radius:95px 95px 50px 50px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 24px 70px rgba(255,45,120,.45),0 0 0 1px rgba(255,255,255,.08);position:relative;animation:float 4s ease-in-out infinite}
    @media(max-width:768px){.pbottle{width:160px;height:230px}}
    .pbottle::after{content:'';position:absolute;top:10px;left:20px;right:20px;height:40%;background:linear-gradient(180deg,rgba(255,255,255,.18) 0%,transparent 100%);border-radius:80px}
    .pb-em{font-size:60px;line-height:1;margin-bottom:4px;position:relative;z-index:1}
    .pb-name{font-size:9px;font-weight:800;letter-spacing:2.5px;color:rgba(255,255,255,.8);text-transform:uppercase;position:relative;z-index:1}
    .pb-dose{font-size:28px;font-weight:900;color:#fff;position:relative;z-index:1}
    .pb-sub{font-size:11px;font-weight:700;color:rgba(255,255,255,.7);position:relative;z-index:1}
    .ptag{position:absolute;background:var(--grad);color:#fff;font-size:11px;font-weight:800;padding:7px 14px;border-radius:var(--pill);white-space:nowrap;box-shadow:0 4px 20px rgba(255,45,120,.4)}
    .ptl{top:22px;left:-8px}
    .pbr{bottom:28px;right:-8px}

    /* TRUST BAR */
    .trust{background:var(--card2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:20px 0;overflow-x:auto}
    .trust-row{display:flex;gap:0;min-width:max-content;margin:0 auto;justify-content:center;flex-wrap:wrap}
    .tpill{display:flex;align-items:center;gap:8px;padding:10px 28px;font-size:13px;font-weight:700;color:var(--white);border-right:1px solid var(--border);white-space:nowrap}
    .tpill:last-child{border-right:none}
    .tpill span{color:var(--green);font-size:16px}
    @media(max-width:768px){.tpill{padding:10px 18px}}

    /* STATS */
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--border);border:1px solid var(--border);border-radius:20px;overflow:hidden;margin-top:44px}
    @media(max-width:640px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
    .stat{background:var(--card2);padding:28px 20px;text-align:center}
    .stat-num{font-size:clamp(30px,4vw,44px);font-weight:900;line-height:1;margin-bottom:6px}
    .stat-lbl{font-size:13px;color:var(--gray);line-height:1.4}

    /* PRODUCT FEATURE */
    .pfeat-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;margin-top:44px}
    @media(max-width:768px){.pfeat-grid{grid-template-columns:1fr;gap:40px}}
    .pfeat-tag{display:inline-block;padding:5px 14px;background:rgba(255,45,120,.1);border:1px solid rgba(255,45,120,.25);border-radius:var(--pill);color:var(--pink);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px}
    .pfeat-title{font-size:clamp(26px,4vw,40px);font-weight:900;line-height:1.1;letter-spacing:-.5px;margin-bottom:16px}
    .pfeat-desc{font-size:16px;color:var(--gray);line-height:1.75;margin-bottom:28px}
    .pfeat-list{display:flex;flex-direction:column;gap:14px;margin-bottom:32px}
    .pfeat-item{display:flex;align-items:flex-start;gap:12px;font-size:15px}
    .pfeat-icon{font-size:20px;flex-shrink:0;margin-top:1px}
    .pfeat-item strong{color:var(--white);display:block;font-size:15px;margin-bottom:2px}
    .pfeat-item span{color:var(--gray);font-size:14px}
    .pfeat-cta{display:inline-block;background:var(--grad);color:#fff;font-size:16px;font-weight:800;padding:16px 36px;border-radius:var(--pill);text-decoration:none;box-shadow:0 10px 40px rgba(255,45,120,.38);transition:transform .2s;animation:pulse 2.8s ease-in-out infinite}
    .pfeat-cta:hover{transform:translateY(-2px)}
    .pfeat-img-wrap{background:linear-gradient(145deg,#180A2E,#0F0F1C);border:1px solid rgba(123,47,190,.3);border-radius:24px;padding:40px;display:flex;justify-content:center;align-items:center;min-height:320px;position:relative;overflow:hidden}
    .pfeat-img-wrap::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 20%,rgba(255,45,120,.12) 0%,transparent 55%)}
    .pfeat-bottle{width:160px;height:230px;background:var(--grad);border-radius:80px 80px 44px 44px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 24px 60px rgba(255,45,120,.4);position:relative;animation:float 4s ease-in-out infinite}
    .pfeat-bottle::after{content:'';position:absolute;top:10px;left:16px;right:16px;height:40%;background:linear-gradient(180deg,rgba(255,255,255,.18) 0%,transparent 100%);border-radius:70px}

    /* BENEFITS */
    .bgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:44px}
    @media(max-width:900px){.bgrid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:480px){.bgrid{grid-template-columns:1fr;max-width:360px;margin-left:auto;margin-right:auto}}
    .bcard{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:28px 22px;transition:border-color .3s,transform .3s}
    .bcard:hover{border-color:rgba(255,45,120,.3);transform:translateY(-3px)}
    .bicon{font-size:36px;margin-bottom:14px}
    .btitle{font-size:16px;font-weight:800;margin-bottom:8px}
    .bdesc{font-size:14px;color:var(--gray);line-height:1.65}

    /* REVIEWS STRIP */
    .rev-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
    @media(max-width:768px){.rev-strip{grid-template-columns:1fr;max-width:440px;margin-left:auto;margin-right:auto}}
    .rstrip{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:24px;transition:border-color .3s}
    .rstrip:hover{border-color:rgba(255,45,120,.2)}
    .rs-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
    .rs-av{width:38px;height:38px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:#fff;flex-shrink:0}
    .rs-name{font-size:14px;font-weight:700}
    .rs-loc{font-size:12px;color:var(--muted)}
    .rs-text{font-size:14px;color:var(--gray);line-height:1.7}
    .rs-verified{font-size:11px;color:var(--green);font-weight:600;margin-top:10px}

    /* FINAL CTA BAND */
    .ctaband{background:linear-gradient(135deg,rgba(123,47,190,.15) 0%,rgba(255,45,120,.1) 100%);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:72px 0;text-align:center}
    .ctaband h2{font-size:clamp(28px,4.5vw,46px);font-weight:900;line-height:1.1;letter-spacing:-.5px;margin-bottom:14px}
    .ctaband p{font-size:18px;color:var(--gray);margin-bottom:32px;max-width:480px;margin-left:auto;margin-right:auto}
    .cb-cta{display:inline-block;background:var(--grad);color:#fff;font-size:18px;font-weight:800;padding:20px 52px;border-radius:var(--pill);text-decoration:none;box-shadow:0 10px 40px rgba(255,45,120,.38);animation:pulse 2.8s ease-in-out infinite;transition:transform .2s}
    .cb-cta:hover{transform:translateY(-2px)}
    .cb-sub{font-size:13px;color:var(--muted);margin-top:16px}

    /* FOOTER */
    .footer{background:var(--card);border-top:1px solid var(--border);padding:32px 0;text-align:center}
    .flinks{display:flex;justify-content:center;gap:22px;margin-bottom:14px;flex-wrap:wrap}
    .flinks a{color:var(--gray);text-decoration:none;font-size:13px}
    .flinks a:hover{color:var(--white)}
    .fcopy{color:var(--muted);font-size:12px;max-width:600px;margin:0 auto;line-height:1.7}
  </style>
</head>
<body>

<!-- ANNOUNCE BAR -->
<div class="ann">🔥 LIMITED TIME: Free Shipping on Orders $50+ &nbsp;|&nbsp; 30-Day Money-Back Guarantee &nbsp;|&nbsp; 50,000+ Happy Customers</div>

<!-- NAV -->
<nav class="nav">
  <div class="nav-in">
    <a href="/" class="logo">X<span>11</span></a>
    <div class="nav-links">
      <a href="#product">The Product</a>
      <a href="#benefits">Benefits</a>
      <a href="#reviews">Reviews</a>
    </div>
    {% if fp %}<a href="{{ fp.url }}" class="nav-cta">Shop Now →</a>{% else %}<a href="/collections/all" class="nav-cta">Shop Now →</a>{% endif %}
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:6px;background:rgba(255,215,0,.08);border:1px solid rgba(255,215,0,.2);border-radius:var(--pill);padding:6px 12px;font-size:12px;font-weight:700;color:var(--gold)">★★★★★ <span>2,847 Reviews</span></div>
          <div style="background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);border-radius:var(--pill);padding:6px 12px;font-size:12px;font-weight:700;color:var(--green)">✓ 50,000+ Customers</div>
        </div>
        <h1>The Creatine Women <span class="grad-text">Actually Stick To.</span></h1>
        <p class="hero-sub">5,000mg of pure creatine monohydrate in 2 delicious strawberry gummies. No powder. No pills. No excuses. Just results.</p>
        <div class="hero-price">
          {% if fp %}
            <span class="price-now">{{ fp.price | money }}</span>
            {% if fp.compare_at_price > fp.price %}<span class="price-was">{{ fp.compare_at_price | money }}</span><span class="price-save">Save {{ fp.compare_at_price | minus: fp.price | times: 100 | divided_by: fp.compare_at_price }}%</span>{% endif %}
          {% else %}
            <span class="price-now">$34.99</span>
            <span class="price-was">$49.99</span>
            <span class="price-save">Save 30%</span>
          {% endif %}
        </div>
        {% if fp %}
          <a href="{{ fp.url }}" class="hero-cta">🛒 Get Yours — Free Shipping</a>
        {% else %}
          <a href="/collections/all" class="hero-cta">🛒 Get Yours — Free Shipping</a>
        {% endif %}
        <div class="hero-proof">
          <span class="stars">★★★★★</span>
          <strong>4.9/5</strong>
          <span>·</span>
          <span>2,847 verified reviews</span>
          <span>·</span>
          <span>✓ 30-day guarantee</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="pvisual">
          {% if fp and fp.featured_image %}
            {{ fp.featured_image | image_url: width: 600 | image_tag: alt: fp.title, loading: 'eager', style: 'width:100%;border-radius:12px;position:relative;z-index:1' }}
          {% else %}
            <img src="{{ 'ad-pt-01.png' | asset_url }}" alt="X11 Creatine Gummies" loading="eager" style="width:100%;border-radius:12px;position:relative;z-index:1">
          {% endif %}
          <div class="ptag ptl">🌱 100% Vegan</div>
          <div class="ptag pbr">⚡ 5,000mg Dose</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust">
  <div class="trust-row">
    <div class="tpill"><span>✓</span> 100% Vegan</div>
    <div class="tpill"><span>✓</span> 5,000mg Creatine</div>
    <div class="tpill"><span>✓</span> No Chalky Powder</div>
    <div class="tpill"><span>✓</span> 30-Day Guarantee</div>
    <div class="tpill"><span>✓</span> Free Shipping $50+</div>
  </div>
</div>

<!-- STATS -->
<section class="sec fi" id="product">
  <div class="wrap tc">
    <div style="display:inline-block;padding:5px 14px;background:rgba(123,47,190,.1);border:1px solid rgba(123,47,190,.25);border-radius:var(--pill);color:#A855F7;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px">Why X11</div>
    <h2 style="font-size:clamp(26px,4vw,42px);font-weight:900;letter-spacing:-.5px;margin-bottom:12px">Backed by science. <span class="grad-text">Loved by women.</span></h2>
    <p style="font-size:clamp(15px,2vw,18px);color:var(--gray);max-width:520px;margin:0 auto">Creatine is the most studied supplement in sports science — and X11 makes it the easiest to actually take.</p>
    <div class="stats-grid fi">
      <div class="stat d1">
        <div class="stat-num grad-text">5,000<span style="font-size:22px">mg</span></div>
        <div class="stat-lbl">Pure creatine monohydrate per serving</div>
      </div>
      <div class="stat d2">
        <div class="stat-num grad-text">2</div>
        <div class="stat-lbl">Gummies is all it takes. That's it.</div>
      </div>
      <div class="stat d3">
        <div class="stat-num grad-text">50K<span style="font-size:22px">+</span></div>
        <div class="stat-lbl">Women on their creatine journey</div>
      </div>
      <div class="stat d4">
        <div class="stat-num" style="background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">94<span style="font-size:22px">%</span></div>
        <div class="stat-lbl">Customer reorder rate</div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCT FEATURE SECTION -->
<section class="sec" style="background:var(--card2)">
  <div class="wrap">
    <div class="pfeat-grid">
      <div class="fi">
        <div class="pfeat-tag">The Product</div>
        <h2 class="pfeat-title">Creatine that finally <span class="grad-text">fits your life.</span></h2>
        <p class="pfeat-desc">Every other form of creatine asks you to compromise. Gritty powder. Chalky shakes. Oversized pills. X11 Gummies give you the full clinical dose in a form you'll actually look forward to.</p>
        <div class="pfeat-list">
          <div class="pfeat-item"><span class="pfeat-icon">🍓</span><div><strong>Real Strawberry Flavor</strong><span>Tastes like a treat, works like a supplement</span></div></div>
          <div class="pfeat-item"><span class="pfeat-icon">💪</span><div><strong>5,000mg Pure Creatine Monohydrate</strong><span>The full clinical dose — every single day</span></div></div>
          <div class="pfeat-item"><span class="pfeat-icon">🌱</span><div><strong>100% Vegan — No Gelatin</strong><span>Plant-based pectin, clean label, no compromises</span></div></div>
          <div class="pfeat-item"><span class="pfeat-icon">✅</span><div><strong>Two Gummies. Done.</strong><span>The easiest supplement habit you'll ever build</span></div></div>
        </div>
        {% if fp %}
          <a href="{{ fp.url }}" class="pfeat-cta">Shop X11 Creatine Gummies →</a>
        {% else %}
          <a href="/collections/all" class="pfeat-cta">Shop X11 Creatine Gummies →</a>
        {% endif %}
      </div>
      <div class="fi d2">
        <div class="pfeat-img-wrap">
          {% if fp and fp.featured_image %}
            {{ fp.featured_image | image_url: width: 500 | image_tag: alt: fp.title, loading: 'lazy', style: 'width:100%;border-radius:12px;position:relative;z-index:1' }}
          {% else %}
            <img src="{{ 'ad-sq-04.png' | asset_url }}" alt="X11 Creatine Gummies" loading="lazy" style="width:100%;border-radius:12px;position:relative;z-index:1">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BENEFITS -->
<section class="sec fi" id="benefits">
  <div class="wrap tc">
    <div style="display:inline-block;padding:5px 14px;background:rgba(255,45,120,.1);border:1px solid rgba(255,45,120,.25);border-radius:var(--pill);color:var(--pink);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px">What you get</div>
    <h2 style="font-size:clamp(26px,4vw,42px);font-weight:900;letter-spacing:-.5px;margin-bottom:12px">Real benefits. <span class="grad-text">Proven by science.</span></h2>
    <p style="font-size:clamp(15px,2vw,18px);color:var(--gray);max-width:520px;margin:0 auto">Creatine isn't just for bodybuilders. It's the most research-backed supplement for women who want to perform and feel better.</p>
    <div class="bgrid" style="margin-top:44px">
      <div class="bcard fi d1">
