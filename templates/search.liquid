<div style="max-width:800px;margin:0 auto;padding:40px 20px">
  <h1 style="font-size:28px;font-weight:900;margin-bottom:24px">Search</h1>
  <form action="/search" method="get" style="margin-bottom:32px">
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." style="width:100%;padding:14px 18px;background:#12121A;border:1px solid rgba(255,255,255,0.1);border-radius:50px;color:#fff;font-size:15px;outline:none">
  </form>
  {% if search.performed %}
    {% for item in search.results %}
      <a href="{{ item.url }}" style="display:block;text-decoration:none;padding:16px 0;border-bottom:1px solid rgba(255,255,255,0.07)">
        <div style="font-weight:700;color:#fff">{{ item.title }}</div>
        <div style="color:#A0A0B0;font-size:14px">{{ item.body | strip_html | truncate: 100 }}</div>
      </a>
    {% endfor %}
  {% endif %}
</div>
